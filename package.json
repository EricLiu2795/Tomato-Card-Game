{
  "name": "tomato-card-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,web \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:persistence": "vitest run --config vitest.persistence.config.ts",
    "format": "prettier --write client shared server tests docs *.ts *.json *.jsonc *.js *.md index.html"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0",
    "ws": "^8.18.0"
  }
}
